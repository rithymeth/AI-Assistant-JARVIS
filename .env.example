OLLAMA_HOST=http://localhost:11434
MODEL_NAME=llama3.2:3b
VISION_MODEL_NAME=moondream
PORT=8000
DB_PATH=./javi.db

# LAN access code — leave unset to auto-generate one (persisted to
# .access_code). Only matters for non-localhost requests; running Javi on
# this machine never needs it.
# ACCESS_CODE=

# Optional: email the access code + LAN URL on every startup so you can
# grab it from your phone without walking over to look at the terminal.
# Leave any of these blank and the feature just no-ops. For Gmail: create
# an App Password at https://myaccount.google.com/apppasswords (NOT your
# normal password) and use that as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
NOTIFY_EMAIL=you@example.com

# Optional: default city for "what's the weather" when you don't name one.
# Leave blank and Javi will just ask which city you mean.
WEATHER_LOCATION=

# Only needed if you're running the LoRA fine-tuning pipeline in training/
# (see training/README.md) — NOT used by the running app itself. Accept the
# Llama 3.2 license at https://huggingface.co/meta-llama/Llama-3.2-3B-Instruct
# with your own HF account, then generate a token (read access is enough) at
# https://huggingface.co/settings/tokens.
HF_TOKEN=
